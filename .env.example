# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./data/vericlaim.db
MOCK_PROVIDER_ENABLED=true
# Keep external retrieval off for normal local development; the live E2E smoke script opts in.
LIVE_RETRIEVAL_ENABLED=false
DEFAULT_PROVIDER=mock
LOG_LEVEL=INFO
# Comma-separated browser origins; keep this explicit in deployed environments.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hard per-request safety bounds; values are validated and cannot exceed the
# conservative application maximums defined in Settings.
MAX_ATOMIC_CLAIMS_PER_REQUEST=8
MAX_RETRIEVAL_QUERIES_PER_REQUEST=16
MAX_EVIDENCE_CANDIDATES_PER_REQUEST=32
MAX_PROVIDER_CALLS_PER_REQUEST=8

# Providers require both *_ENABLED=true and a corresponding API key.
# Keep these false for deterministic/offline development.
CEREBRAS_ENABLED=false
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Gemini is disabled unless explicitly enabled.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OKMD_ENABLED=false
OKMD_API_KEY=
OKMD_MODEL=deepseek-v4-flash

THAILLM_ENABLED=false
THAILLM_API_KEY=
THAILLM_MODEL=OpenThaiGPT-ThaiLLM-8B-Instruct-v7.2

# Evaluation must opt in before using a non-deterministic OpenRouter free route.
ALLOW_NON_REPRODUCIBLE_OPENROUTER=false

# Browser API target
NEXT_PUBLIC_API_URL=http://localhost:8000
